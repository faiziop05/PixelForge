{
  "expo": {
    "name": "PixelForge",
    "slug": "pixelforge",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon1.png",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/splash-icon1.png",
      "resizeMode": "contain",
      "backgroundColor": "#000000"
    },
    "assetBundlePatterns": ["**/*"],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.pixelforge.app"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/splash-icon1.png",
        "backgroundColor": "#000000"
      },
      "permissions": [
        "WRITE_EXTERNAL_STORAGE",
        "READ_EXTERNAL_STORAGE",
        "CAMERA",
        "READ_MEDIA_IMAGES",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.READ_MEDIA_VISUAL_USER_SELECTED",
        "android.permission.ACCESS_MEDIA_LOCATION",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.SET_WALLPAPER"
      ],
      "package": "com.pixelforge.app"
    },
    "web": {
      "favicon": "./assets/favicon2.png"
    },
    "plugins": [
      [
        "expo-media-library",
        {
          "photosPermission": "Allow PixelForge to access your photos.",
          "savePhotosPermission": "Allow PixelForge to save backgrounds.",
          "audioPermission": "Allow PixelForge to access your audio.",
          "isAccessMediaLocationEnabled": true
        }
      ],
      "./plugins/withAndroidWallpaperConfig"
    ],
    "extra": {
      "eas": {
        "projectId": "08d4f317-96e4-4cbf-ae1e-ee198196eab2"
      }
    }
  }
}
